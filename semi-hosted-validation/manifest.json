    "git_blob": "852a956e0530a33fac6a6f8a9c1f48375253b20c",
    "cases": [
      {
        "full_name": "InputNumberFoundation currency fraction digits keeps the default USD fraction digits when no precision options are supplied",
        "input": 12,
        "options": {},
        "expected": "$12.00",
        "predicted_status": "passed",
        "predicted_received": "$12.00",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits keeps a positive precision",
        "input": 12.3,
        "options": {
          "precision": 2
        },
        "expected": "$12.30",
        "predicted_status": "passed",
        "predicted_received": "$12.30",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits keeps positive minimum and maximum fraction digit options",
        "input": 12.3456,
        "options": {
          "minimumFractionDigits": 2,
          "maximumFractionDigits": 4
        },
        "expected": "$12.3456",
        "predicted_status": "passed",
        "predicted_received": "$12.3456",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits respects an explicit minimumFractionDigits of zero",
        "input": 12,
        "options": {
          "minimumFractionDigits": 0
        },
        "expected": "$12",
        "predicted_status": "failed",
        "predicted_received": "$12.00",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits respects an explicit maximumFractionDigits of zero",
        "input": 12,
        "options": {
          "maximumFractionDigits": 0
        },
        "expected": "$12",
        "predicted_status": "failed",
        "predicted_received": "$12.00",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits respects an explicit precision of zero",
        "input": 12,
        "options": {
          "precision": 0
        },
        "expected": "$12",
        "predicted_status": "failed",
        "predicted_received": "$12.00",
        "prediction_only_not_measured": true
      },
      {
        "full_name": "InputNumberFoundation currency fraction digits respects explicit zero minimum and maximum fraction digits together",
        "input": 12,
        "options": {
          "minimumFractionDigits": 0,
          "maximumFractionDigits": 0
        },
        "expected": "$12",
        "predicted_status": "failed",
        "predicted_received": "$12.00",
        "prediction_only_not_measured": true
      }
    ],
